{
  "name": "Apex-Sec",
  "short_name": "Apex-Sec",
  "description": "Security console: recon, encoders, hashes, bug bounty reporting and a toolset directory. Works offline.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#0b0e11",
  "theme_color": "#0b0e11",
  "categories": ["developer", "utilities", "security"],
  "icons": [
    {
      "src": "icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    { "name": "Recon", "url": "./#recon", "description": "Probe a target" },
    { "name": "Payload", "url": "./#payload", "description": "Encode and hash" },
    { "name": "Report", "url": "./#report", "description": "Write a finding" }
  ]
}
